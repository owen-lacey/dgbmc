# Recognizability level for actor filtering (8, 9, or 10)
# Defaults to 10 if not set
NEXT_PUBLIC_RECOGNIZABILITY=10

# Hide actors who are not best known for acting (true/false)
# This filters out singers, athletes, TV personalities, etc. who have appeared in movies
# Defaults to false if not set
NEXT_PUBLIC_HIDE_NON_ACTORS=false
